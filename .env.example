# Sanity project (public — safe to expose at build time)
NEXT_PUBLIC_SANITY_PROJECT_ID=i9s1a5ax
NEXT_PUBLIC_SANITY_DATASET=production

# Editor token for public form submissions (server only — never prefix with NEXT_PUBLIC_)
SANITY_API_WRITE_TOKEN=

# Read token for DRAFT content — required by Sanity Presentation (live preview).
# Create with: npx sanity tokens add "Preview" --role viewer
SANITY_API_READ_TOKEN=

# Shared secret for POST /api/revalidate (also set as the Sanity webhook header)
REVALIDATE_SECRET=

# Shared secret for the draft-mode handshake used by Sanity Presentation.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Must equal SANITY_STUDIO_PREVIEW_SECRET in the Studio environment.
#   -> site:   Vercel → Settings → Environment Variables (then redeploy)
#   -> studio: .env.local, then `npm run studio:deploy`
SANITY_PREVIEW_SECRET=

# Canonical site URL used for metadata, sitemap and robots
NEXT_PUBLIC_SITE_URL=https://envirohension.vercel.app

# ── Studio-side (sanity.config.ts) ──────────────────────────────────────────
# Sanity only inlines SANITY_STUDIO_* prefixed vars into the Studio bundle,
# so the preview handshake MUST use that prefix to reach presentationTool.
SANITY_STUDIO_PREVIEW_URL=https://envirohension.vercel.app
SANITY_STUDIO_PREVIEW_SECRET=   # same value as SANITY_PREVIEW_SECRET above
