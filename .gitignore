# See https://help.github.com/articles/ignoring-files/ for more information.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# sanity
# Compiled Sanity Studio
/dist
# Temporary Sanity runtime, generated by the CLI on every dev server start
/.sanity

# logs
/logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# misc
.DS_Store
*.pem

# env files (never commit secrets)
.env*
*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tooling
.gstack/

# graphify knowledge graph (derived, regenerate with `graphify update .`)
/graphify-out/
